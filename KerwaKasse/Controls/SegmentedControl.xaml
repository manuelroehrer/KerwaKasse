<UserControl x:Class="KerwaKasse.Controls.SegmentedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:KerwaKasse.Controls"
             xmlns:helper="clr-namespace:KerwaKasse.Helper"
             mc:Ignorable="d" x:Name="Root"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             d:DesignHeight="40" d:DesignWidth="240">
    <UserControl.Resources>
        <helper:SegmentCornerRadiusConverter x:Key="SegmentCornerRadius"/>
        <helper:SegmentDividerVisibilityConverter x:Key="SegmentDivider"/>
    </UserControl.Resources>

    <!-- One rounded frame around all segments. Each segment is a chrome-free button; the selected
         one (item.IsSelected) is filled with the accent colour, dividers sit between segments. -->
    <Border CornerRadius="3" BorderBrush="{DynamicResource TextControlBorderBrush}" BorderThickness="1"
            Background="White" SnapsToDevicePixels="True">
        <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent"
                            Command="{Binding Command, RelativeSource={RelativeSource AncestorType={x:Type controls:SegmentedControl}}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Rounded fill kept CHILDLESS: a Border with a corner radius clips its
                                         child, which would crop descenders (g, …) of a centred label. The label
                                         is therefore a sibling on top, never clipped. -->
                                    <Border x:Name="fill" Background="Transparent">
                                        <Border.CornerRadius>
                                            <!-- Round only the outer corners (first/last segment). -->
                                            <MultiBinding Converter="{StaticResource SegmentCornerRadius}" ConverterParameter="2">
                                                <Binding/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                            </MultiBinding>
                                        </Border.CornerRadius>
                                    </Border>

                                    <ContentPresenter x:Name="content" Content="{Binding Label}"
                                                      Margin="{Binding SegmentPadding, RelativeSource={RelativeSource AncestorType={x:Type controls:SegmentedControl}}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="#3A4453"/>

                                    <!-- Vertical divider on the right of every segment but the last. -->
                                    <Border x:Name="divider" Width="1" HorizontalAlignment="Right"
                                            Background="{DynamicResource TextControlBorderBrush}">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource SegmentDivider}">
                                                <Binding/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="fill" Property="Background" Value="#F2F4F7"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="fill" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        <Setter TargetName="content" Property="TextElement.Foreground" Value="White"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
