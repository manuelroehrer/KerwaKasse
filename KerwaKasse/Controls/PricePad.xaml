<UserControl x:Class="KerwaKasse.Controls.PricePad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             d:DesignWidth="300">
    <UserControl.Resources>
        <!-- Touch-sized key. Not focusable, so a tap never moves the keyboard focus away from the pad
             and Enter/Space keep their meaning for the dialog. -->
        <Style x:Key="PadKey" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="Foreground" Value="#1B1E24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F1F2F4" BorderBrush="#E1E3E6" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E7E9EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DADDE1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- The value is shown as text, not in a text box: tapping it does nothing, the keys below type. -->
        <Border x:Name="DisplayBorder" BorderBrush="#C9CDD3" BorderThickness="1" Padding="14,6"
                CornerRadius="{DynamicResource ControlCornerRadius}" Background="White">
            <TextBlock x:Name="DisplayText" FontFamily="Cascadia Mono, Consolas" FontSize="30" FontWeight="SemiBold"
                       Foreground="#1B1E24" HorizontalAlignment="Right"/>
        </Border>
        <TextBlock x:Name="SuggestionHint" Text="Vorschlag. Zum Ändern einfach die neue Zahl tippen."
                   FontSize="12.5" Foreground="#8A8F96" Margin="2,5,0,0" Visibility="Collapsed"/>

        <UniformGrid Columns="3" Margin="-3,8,-3,0">
            <Button Style="{StaticResource PadKey}" Content="7" Tag="7" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="8" Tag="8" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="9" Tag="9" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="4" Tag="4" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="5" Tag="5" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="6" Tag="6" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="1" Tag="1" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="2" Tag="2" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="3" Tag="3" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="," Tag="," Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Content="0" Tag="0" Click="Key_Click"/>
            <Button Style="{StaticResource PadKey}" Tag="back" Click="Key_Click" ToolTip="Löschen"
                    AutomationProperties.Name="Löschen">
                <TextBlock Text="&#xE750;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
            </Button>
        </UniformGrid>
    </StackPanel>
</UserControl>
