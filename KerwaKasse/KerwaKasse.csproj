<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KerwaKasse</RootNamespace>
    <AssemblyName>KerwaKasse</AssemblyName>
    <ApplicationIcon>KerwaKasse.ico</ApplicationIcon>
    <Product>KerwaKasse</Product>
    <Copyright>© 2022–$([System.DateTime]::Now.Year) Manuel Röhrer</Copyright>
    <Authors>Manuel Röhrer</Authors>
    <AssemblyVersion>2.11.0</AssemblyVersion>
    <FileVersion>2.11.0</FileVersion>
	<Version>2.11.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="KerwaKasse.ico" />
  </ItemGroup>

  <!-- Ship the license documents with every build. The installer packs the publish folder
       as-is, so they end up in the installation automatically; the info page opens the
       third-party notices from there. -->
  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="LiveChartsCore" Version="2.0.5" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView" Version="2.0.5" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="QuestPDF" Version="2026.7.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KerwaKasse.Core\KerwaKasse.Core.csproj" />
  </ItemGroup>

</Project>
