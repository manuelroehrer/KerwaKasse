<UserControl x:Class="KerwaKasse.MVVM.View.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KerwaKasse.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="MainGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Verlauf" Foreground="Black" FontSize="30" Margin="20,0,0,0"/>

        <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1" Margin="20,0,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10,0,0,20">
                    <TextBlock Text="Tag auswählen:" FontSize="18" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <DatePicker IsTodayHighlighted="True" SelectedDate="{Binding Date}" DisplayDate="{Binding Date}" SelectedDateFormat="Long"/>
                </StackPanel>

                <!-- Empty state: no orders recorded for the selected day -->
                <StackPanel DockPanel.Dock="Top" Margin="10,28,0,0" HorizontalAlignment="Left" MaxWidth="460">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Orders.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#C0C0C0" Margin="0,0,0,12"/>
                    <TextBlock Text="Keine Verkäufe an diesem Tag" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Für den ausgewählten Tag wurden keine Verkäufe erfasst."
                               FontSize="14" Foreground="#909090" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Path=Orders}" x:Name="OrderControl" VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="1" Margin="2" Padding="10">
                                <Expander>
                                    <Expander.Header>
                                        <Grid HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWayToSource}">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OrderTime, StringFormat='{}{0:HH:mm}'}" FontSize="20"/>
                                            <DockPanel Grid.Column="1" x:Name="expanderInfoDock">
                                                <TextBlock Text="{Binding Total, StringFormat={}{0:C}}" FontSize="20" HorizontalAlignment="Right" Grid.Column="2" DockPanel.Dock="Right"/>
                                                <TextBlock Text="{Binding ShortDescription}" FontSize="15" TextTrimming="CharacterEllipsis" Grid.Column="1" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <DockPanel Margin="0,10,0,0" LastChildFill="False" x:Name="expanderContent">
                                        <Border Background="LightGray" HorizontalAlignment="Stretch" DockPanel.Dock="Top">
                                            <Grid Margin="10,5,10,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="Bold" Grid.Column="0" Text="Name" FontSize="16"/>
                                                <TextBlock FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center" Text="Anzahl" FontSize="16"/>
                                                <TextBlock FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Center" Text="Einzelpreis" FontSize="16"/>
                                                <TextBlock FontWeight="Bold" Grid.Column="3" HorizontalAlignment="Center" Text="Gesamtpreis" FontSize="16"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding OrderPositions}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" DockPanel.Dock="Top">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,5,10,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Product.Name}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{Binding Amount}" FontSize="16"/>
                                                        <TextBlock Grid.Column="2" Margin="0,0,15,0"  HorizontalAlignment="Right" Text="{Binding Product.Price, StringFormat={}{0:C}}" FontSize="16"/>
                                                        <TextBlock Grid.Column="3" Margin="0,0,15,0" HorizontalAlignment="Right" Text="{Binding Total, StringFormat={}{0:C}}" FontSize="16"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border DockPanel.Dock="Top" HorizontalAlignment="Stretch" Height="1.5" Background="Black" Margin="6"/>
                                        <Grid DockPanel.Dock="Top" HorizontalAlignment="Stretch"  Margin="0,0,25,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Right" Text="Gesamt" />
                                            <TextBlock FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Right" Text="{Binding Total, StringFormat={}{0:C}}" Grid.Column="1"/>
                                        </Grid>
                                        
                                        
                                        <Button Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                DockPanel.Dock="Bottom" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="&#xE104;" Foreground="White" FontSize="18" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                                    <Label Content="Bearbeiten" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </DockPanel>
                                    
                                    <Expander.Triggers>
                                        <EventTrigger RoutedEvent="Expander.Expanded">
                                            <EventTrigger.Actions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="expanderInfoDock"
                                                                                 Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:0"/>
                                                        <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="expanderContent"
                                                                                 Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.Actions>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Expander.Collapsed">
                                            <EventTrigger.Actions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="expanderInfoDock"
                                                                                 Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0"/>
                                                        <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetName="expanderContent"
                                                                                 Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.Actions>
                                        </EventTrigger>
                                    </Expander.Triggers>
                                    
                                </Expander>
                                <Border.Effect>
                                    <DropShadowEffect  BlurRadius="4" ShadowDepth="0.5" Direction="-45" Color="Black"/>
                                </Border.Effect>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </ScrollViewer>
        
    </Grid>
</UserControl>
