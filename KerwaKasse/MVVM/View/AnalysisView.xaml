<UserControl x:Class="KerwaKasse.MVVM.View.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:helper="clr-namespace:KerwaKasse.Helper"
             xmlns:controls="clr-namespace:KerwaKasse.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helper:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <FontFamily x:Key="PriceFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8F96"/>
        </Style>

        <!-- ModernWpf sizes the inner DatePickerTextBox to the standard text-control height and ignores
             the DatePicker's Height, so the date box stayed shorter than the time ComboBox next to it.
             Enlarging the inner text box makes the date pickers honour the 38px toolbar height. -->
        <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type DatePickerTextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="35"/>
        </Style>

        <!-- Accent text-button for "Alle"/"Keine" — same look as in the Auswertungen-/Speisekarten-Dialog. -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9ECF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-style dropdown trigger (Produkte / Auswertungen). -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3A4453"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F6F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active-aware variant for the saved-analyses pill (tinted when one is active). -->
        <Style x:Key="ActivePillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasActiveAnalysis}" Value="True">
                    <Setter Property="Background" Value="#E4EAF1"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlyoutRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F2F4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Saved-analysis row: like FlyoutRowButton, but tinted when it is the active analysis. -->
        <Style x:Key="SavedRowButton" TargetType="Button" BasedOn="{StaticResource FlyoutRowButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#E4EAF1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12" PreviewMouseDown="Root_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Auswertung" FontSize="30" FontWeight="SemiBold" Margin="4,0,4,12"/>

        <!-- Toolbar: time line + data line, grouped in one card -->
        <Border Grid.Row="1" Margin="4,0,4,0" CornerRadius="8" Background="White" BorderBrush="#E0E3E7" BorderThickness="1" Padding="12,10">
            <StackPanel>
                <!-- Line 1: Zeitraum — quick-picks first, then the exact from/to range.
                     Symmetric top/bottom margins so every item centres on the same line. -->
                <WrapPanel>
                    <TextBlock Text="Zeitraum" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="2,3,14,3"/>
                    <controls:SegmentedControl ItemsSource="{Binding QuickRanges}" Command="{Binding SelectQuickRangeCommand}"
                                               SegmentPadding="15,8" FontSize="13.5" VerticalAlignment="Center" Margin="0,3,0,3"/>
                    <!-- Stronger separator between the quick-picks and the exact range. -->
                    <Border Width="2" Height="28" Background="#C4CBD4" VerticalAlignment="Center" Margin="20,3,20,3"/>
                    <!-- Date+time grouped so they wrap together. -->
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" DisplayDate="{Binding DateFrom}" Height="35" 
                                Width="130" VerticalAlignment="Center" Margin="0,3,6,3"/>
                        <ComboBox ItemsSource="{Binding TimeFrom_Values}" SelectedItem="{Binding TimeFrom}" Width="80" Height="35"
                                  ItemStringFormat="{}{0:HH:mm}" VerticalAlignment="Center" Margin="0,3,0,3"/>
                    </StackPanel>
                    
                    <TextBlock Text="bis" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" Margin="12,3,12,3"/>
                    
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateTo}" DisplayDate="{Binding DateTo}" Height="35" 
                                    Width="130" VerticalAlignment="Center" Margin="0,3,6,3"/>
                        <ComboBox ItemsSource="{Binding TimeTo_Values}" SelectedItem="{Binding TimeTo}" Width="80" Height="35"
                                  ItemStringFormat="{}{0:HH:mm}" VerticalAlignment="Center" Margin="0,3,0,3"/>
                    </StackPanel>
                </WrapPanel>

                <Border Height="1" Background="#EDEFF2" Margin="0,4,0,10"/>

                <!-- Line 2: Produkte (left) + saved analyses (right) -->
                <DockPanel>
                    <!-- Saved-analyses dropdown (right): label outside, pill shows only the active state -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Auswertung" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="AuswertungButton" Style="{StaticResource ActivePillButton}" VerticalAlignment="Center"
                            MinWidth="240" MaxWidth="400" ToolTipService.ToolTip="Gespeicherte Auswertungen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       Visibility="{Binding HasActiveAnalysis, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ActiveAnalysisText, Mode=OneWay}"/>
                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"/>
                            </Grid>
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout Placement="BottomEdgeAlignedRight">
                                    <ui:Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="ui:FlyoutPresenter">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ui:Flyout.FlyoutPresenterStyle>
                                    <DockPanel Width="320">
                                        <Border DockPanel.Dock="Top" Background="#F7F8FA" CornerRadius="8,8,0,0"
                                            BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="14,12">
                                            <StackPanel>
                                                <TextBlock Text="GESPEICHERTE AUSWERTUNGEN" Style="{StaticResource CaptionText}"/>
                                                <TextBlock Margin="0,4,0,0" FontSize="14"
                                                       Visibility="{Binding HasActiveAnalysis, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Aktiv: " Foreground="#8A8F96"/><Run Text="{Binding ActiveAnalysisText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#EDEFF2" BorderThickness="0,1,0,0"
                                            CornerRadius="0,0,8,8" Padding="6">
                                            <StackPanel>
                                                <Button Style="{StaticResource FlyoutRowButton}" Command="{Binding SaveCurrentCommand}" Click="CloseAuswertungFlyout_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#586070"
                                                               VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                        <TextBlock Text="Aktuelle Auswertung speichern …" FontSize="14.5" Foreground="#374151" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource FlyoutRowButton}" Command="{Binding ManageCommand}" Click="CloseAuswertungFlyout_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#586070"
                                                               VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                        <TextBlock Text="Verwalten …" FontSize="14.5" Foreground="#374151" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="6,8">
                                            <TextBlock Text="Noch keine gespeicherten Auswertungen" FontSize="13.5" Foreground="#9AA0A6"
                                                   TextWrapping="Wrap" Margin="8,8"
                                                   Visibility="{Binding HasSavedAnalyses, Converter={StaticResource InverseBoolToVisibility}}"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                                <ItemsControl ItemsSource="{Binding SavedAnalyses}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource SavedRowButton}" Margin="0,1" Click="CloseAuswertungFlyout_Click"
                                                                Command="{Binding DataContext.ApplySavedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Id}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                                           Foreground="#1B1E24" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="#7B8492" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </DockPanel>
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Product filter dropdown (left) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Produkte" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="2,0,14,0"/>
                        <Button Style="{StaticResource PillButton}" MinWidth="190"
                                ToolTipService.ToolTip="Produkte für die Auswertung wählen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding ProductFilterSummary, Mode=OneWay}"/>
                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"/>
                            </Grid>
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout Placement="Bottom">
                                    <ui:Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="ui:FlyoutPresenter">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ui:Flyout.FlyoutPresenterStyle>
                                    <DockPanel Width="300">
                                        <Border DockPanel.Dock="Top" Padding="12,12,12,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallActionButton}"
                                                        Command="{Binding ClearProductsCommand}" Content="Keine"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallActionButton}"
                                                        Command="{Binding SelectAllProductsCommand}" Content="Alle" Margin="0,0,4,0"/>
                                                <TextBlock Text="PRODUKTE" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                                            <TextBox Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="36" VerticalContentAlignment="Center" Padding="34,0,10,0"/>
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#8B929E"
                                                       IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                                        </Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="6,0,6,8">
                                            <ItemsControl ItemsSource="{Binding FilteredProductFilter}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinHeight="35"
                                                                  VerticalContentAlignment="Center" Margin="6,1" Padding="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="12" Height="12" CornerRadius="3" Background="{Binding ColorBrush}"
                                                                        BorderBrush="{Binding ColorBorderBrush}" BorderThickness="1"
                                                                        Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- View selector + export -->
        <Grid Grid.Row="2" Margin="4,16,4,0">
            <!-- The segment sizes to its content (no fixed height → no white gap); the export button
                 stretches to that same height so both sit on one line at equal height. -->
            <controls:SegmentedControl ItemsSource="{Binding ViewModes}" Command="{Binding SetViewModeCommand}"
                                       SegmentPadding="18,8" FontSize="14.5" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CustomAccentButtonStyle}" VerticalAlignment="Stretch"
                        Padding="18,0" Margin="0,0,10,0" Command="{Binding ExportPdfCommand}"
                        ToolTipService.ToolTip="Aktuelle Tabelle als PDF exportieren">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Export PDF" FontSize="14.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CustomAccentButtonStyle}" VerticalAlignment="Stretch"
                        Padding="18,0" Command="{Binding ExportCsvCommand}"
                        ToolTipService.ToolTip="Aktuelle Tabelle als CSV exportieren">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Export CSV" FontSize="14.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content card -->
        <Border Grid.Row="3" Margin="4,12,4,4" CornerRadius="8" Background="White" BorderBrush="#E0E3E7" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.07" Color="Black"/>
            </Border.Effect>
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                            Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#C8CDD4"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Keine Verkäufe für diese Auswahl" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Passe Zeitraum oder Produktauswahl an." FontSize="13.5" Foreground="#909090"
                               HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Übersicht (breakdown) -->
                <Grid Visibility="{Binding IsBreakdown, Converter={StaticResource BoolToVisibility}}">
                    <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Table -->
                        <DockPanel Grid.Column="0" Margin="4,0,0,0">
                            <Border DockPanel.Dock="Top" BorderBrush="#EDEFF2" BorderThickness="0,0,0,1">
                                <Grid Margin="16,0,32,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Clickable headers: first click sorts the column, a second click flips the
                                         direction. The transparent borders carry the header row's vertical padding,
                                         so the whole column cell is the hit area, not just the caption text. -->
                                    <Border Grid.Column="0" Background="Transparent" Padding="0,12" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding SortBreakdownCommand}" CommandParameter="Name"/>
                                        </Border.InputBindings>
                                        <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Left">
                                            <Run Text="PRODUKT"/><Run Text="{Binding NameSortIndicator, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Grid.Column="1" Background="Transparent" Padding="0,12" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding SortBreakdownCommand}" CommandParameter="Amount"/>
                                        </Border.InputBindings>
                                        <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right">
                                            <Run Text="MENGE"/><Run Text="{Binding AmountSortIndicator, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Grid.Column="2" Background="Transparent" Padding="0,12" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding SortBreakdownCommand}" CommandParameter="Revenue"/>
                                        </Border.InputBindings>
                                        <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right">
                                            <Run Text="UMSATZ"/><Run Text="{Binding RevenueSortIndicator, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Total row (invoice style) -->
                            <Border DockPanel.Dock="Bottom" BorderBrush="#CBD2DA" BorderThickness="0,1.5,0,0" Padding="16,12,32,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gesamt" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#1B2430" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalAmount}" FontSize="14" Foreground="#5F6875"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat={}{0:C}}" FontSize="16"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontFamily="{StaticResource PriceFont}"/>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Breakdown}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Transparent background so the whole row (not just its texts) hit-tests
                                                 for the price-history tooltip. -->
                                            <Border BorderBrush="#F3F5F7" BorderThickness="0,0,0,1" Padding="16,9,32,9"
                                                    Background="Transparent"
                                                    ToolTipService.IsEnabled="{Binding HasPriceDetails}"
                                                    ToolTipService.InitialShowDelay="400">
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <!-- Shared size scope keeps the price column equally wide across
                                                             all lines, so the right-aligned date ranges line up. -->
                                                        <StackPanel Margin="4,3" Grid.IsSharedSizeScope="True">
                                                            <TextBlock Text="{Binding PriceDetailsHeader}" FontSize="13"
                                                                       FontWeight="SemiBold" Margin="0,0,0,7"/>
                                                            <ItemsControl ItemsSource="{Binding PriceDetails}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,1">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PriceColumn"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Price}" FontFamily="Consolas"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Range}" FontFamily="Consolas"
                                                                                       HorizontalAlignment="Right" Margin="18,0,0,0"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="125"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Border Width="13" Height="13" CornerRadius="3" Background="{Binding ColorBrush}"
                                                                BorderBrush="{Binding ColorBorderBrush}" BorderThickness="1"
                                                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="14.5" Foreground="#3A4453"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:C}}" FontSize="14.5"
                                                               Foreground="#3A4453" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource PriceFont}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Donut + own scrollable legend (the built-in legend grew unbounded and
                             squeezed/clipped the chart when there were many products). -->
                        <Grid Grid.Column="1" Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <lvc:PieChart Grid.Column="0" x:Name="DonutChart" Series="{Binding PieSeries}" LegendPosition="Hidden"
                                          SizeChanged="DonutChart_SizeChanged"
                                          Margin="4,12,8,12" Background="Transparent" MaxHeight="520" MinWidth="160"/>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,12,2,12">
                                <ItemsControl ItemsSource="{Binding Breakdown}" Width="196">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Border Width="11" Height="11" CornerRadius="3" Background="{Binding ColorBrush}"
                                                        BorderBrush="{Binding ColorBorderBrush}" BorderThickness="1"
                                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#3A4453"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="168"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Zeitverlauf (time course): resolution on top, chart fills. ZoomMode=X lets you zoom into
                     long ranges (where bars get very thin); the default still fits everything on screen. -->
                <Grid Visibility="{Binding IsTimeCourse, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,12,14,0">
                            <TextBlock Text="Auflösung" FontSize="12.5" Foreground="#8A8F96" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <controls:SegmentedControl ItemsSource="{Binding Resolutions}" Command="{Binding SelectResolutionCommand}"
                                                       SegmentPadding="13,7" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <lvc:CartesianChart Series="{Binding TimeCourseSeries}" XAxes="{Binding TimeCourseXAxes}" YAxes="{Binding TimeCourseYAxes}"
                                            Margin="14,8,14,14" Background="Transparent" TooltipPosition="Top" ZoomMode="X"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
