<UserControl x:Class="KerwaKasse.MVVM.View.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KerwaKasse.MVVM.View"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="750">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Small square icon button inside a flyout row (rename / delete an event). -->
        <Style x:Key="FlyoutIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#586070"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDE2E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The active event cannot be deleted: hide (not collapse) its delete button, so the rename
             buttons of all rows stay aligned. -->
        <Style x:Key="FlyoutDeleteButton" TargetType="Button" BasedOn="{StaticResource FlyoutIconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Light card used to group the sections on the page. A full 1px border
             defines all four edges (a directional drop shadow alone made the left
             and top edges blend into the page background). -->
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E3E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,16,20,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,10,20,10">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Info" Foreground="Black" FontSize="30" Margin="0,0,0,20"/>

            <!-- Header: app identity + version -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Image Source="/Assets/KerwaKasse.png" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KerwaKasse" Foreground="Black" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Version}" Foreground="#707070" FontSize="15" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Über die App -->
            <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                    <TextBlock Text="Über die App" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="22"
                               Text="KerwaKasse unterstützt den bargeldbasierten Verkauf bei Vereinsveranstaltungen, insbesondere im Gastronomiebereich. Die Anwendung erleichtert ehrenamtlichen Helfern die Arbeit an der Bargeldkasse: Bestellungen lassen sich schnell per Klick zusammenstellen, Preise werden automatisch berechnet und die erfassten Verkäufe können im Nachgang ausgewertet werden."/>
                    <!-- Blue info callout (not a warning): this note is informational, unlike the amber
                         cautions elsewhere on this page. -->
                    <Border Background="#EAF2FB" BorderBrush="#C2DBF0" BorderThickness="1" CornerRadius="4"
                            Padding="12,10,12,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2A6FB0"
                                       VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#2A4A66" FontSize="14" LineHeight="20"
                                       Text="Kein zertifiziertes, TSE-konformes Kassensystem; nicht für den regulären gewerblichen Betrieb vorgesehen."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Veranstaltung + Datensicherung: in one card, so it is obvious that backup and restore
                 always act on the event selected above them. -->
            <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                    <TextBlock Text="Veranstaltung" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="22"
                               Text="Produkte, Speisekarten, Verkäufe und Auswertungen werden je Veranstaltung getrennt gespeichert. Für eine weitere Veranstaltung mit anderem Angebot kann eine neue Veranstaltung angelegt werden."/>

                    <!-- Event selector: same dropdown idiom as the Speisekarte on the products page. -->
                    <Button x:Name="EventButton" Style="{StaticResource DropDownPillButton}" DataContext="{Binding Events}"
                            Width="340" Height="42" HorizontalAlignment="Left" Margin="0,16,0,0"
                            ToolTipService.ToolTip="Veranstaltung wechseln oder verwalten">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveEventName}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#1B1E24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                        </Grid>
                        <ui:FlyoutService.Flyout>
                            <ui:Flyout Placement="BottomEdgeAlignedLeft" Opened="EventFlyout_Opened" Closed="EventFlyout_Closed">
                                <ui:Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="ui:FlyoutPresenter">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ui:Flyout.FlyoutPresenterStyle>
                                <DockPanel Width="430">
                                    <!-- Header banner (active event) -->
                                    <Border DockPanel.Dock="Top" Background="#F7F8FA" CornerRadius="8,8,0,0"
                                            BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="VERANSTALTUNG" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8F96"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="14">
                                                <Run Text="Aktiv: " Foreground="#8A8F96"/><Run Text="{Binding ActiveEventName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Footer banner (new event) -->
                                    <Border DockPanel.Dock="Bottom" Background="#F7F8FA" CornerRadius="0,0,8,8"
                                            BorderBrush="#EDEFF2" BorderThickness="0,1,0,0" Padding="6">
                                        <Button Style="{StaticResource FlyoutFooterButton}" Click="CreateEvent_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#586070"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="Neue Veranstaltung …" FontSize="14.5" Foreground="#374151"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>

                                    <!-- Event list: tap a row to switch; rename/delete sit on the right. -->
                                    <ScrollViewer Margin="6" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                        <ItemsControl ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Button Style="{StaticResource FlyoutRowButton}" Click="EventOption_Click" Padding="10,8,82,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                           Foreground="#1B1E24" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Details}" FontSize="12.5" Foreground="#8A8F96"
                                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Button Style="{StaticResource FlyoutIconButton}" Click="RenameEvent_Click"
                                                                    Content="&#xE70F;" ToolTip="Umbenennen" AutomationProperties.Name="Umbenennen"/>
                                                            <Button Style="{StaticResource FlyoutDeleteButton}" Click="DeleteEvent_Click"
                                                                    Content="&#xE74D;" ToolTip="Löschen" AutomationProperties.Name="Löschen"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </ui:Flyout>
                        </ui:FlyoutService.Flyout>
                    </Button>
                    <TextBlock Text="{Binding Events.ActiveEvent.Details}" Foreground="#707070" FontSize="14" Margin="2,8,0,0"/>

                    <Border Height="1" Background="#EDEFF2" Margin="0,20,0,16"/>

                    <TextBlock Foreground="Black" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"
                               Text="{Binding Events.ActiveEventName, StringFormat='Datensicherung von „{0}“'}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="22"
                               Text="Erstellt eine Sicherungskopie der aktiven Veranstaltung. Es wird empfohlen, diese auf einem externen Speichermedium (z. B. USB-Stick) oder auf einem separaten Datenträger zu speichern."/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Command="{Binding BackupCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <Path Fill="White" Stretch="Uniform"
                                              Data="{StaticResource BackupIcon}"/>
                                    </Viewbox>
                                    <Label Content="Backup erstellen" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="&#xE8E5;" FontSize="16" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Label Content="Wiederherstellen" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Update -->
            <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                    <TextBlock Text="Update" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock FontSize="15">
                        <Hyperlink Command="{Binding OpenReleasesCommand}">Releases auf GitHub</Hyperlink>
                    </TextBlock>
                    <!-- Only visible when the startup check was switched off by hand in settings.json. -->
                    <Border Background="#FBF5E6" BorderBrush="#EBD9A8" BorderThickness="1" CornerRadius="4"
                            Padding="10,7,12,7" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding StartupCheckDisabled, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B8860B"
                                       VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Automatische Updateprüfung beim Start ist deaktiviert."
                                       FontSize="14" Foreground="#6B5A22" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding CheckForUpdatesCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="&#xE72C;" FontSize="16" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Label Content="Auf Update prüfen" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="#707070" FontSize="14"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#107C10"
                                   VerticalAlignment="Center" Margin="7,1,0,0"
                                   Visibility="{Binding UpdateStatusIsPositive, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Entwickler (eingeklappt) -->
            <Border Style="{StaticResource InfoCard}">
                <Expander Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <TextBlock Text="Erweitert" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="#FBF5E6" BorderBrush="#EBD9A8" BorderThickness="1" CornerRadius="4"
                                Padding="12,10,12,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B8860B"
                                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#6B5A22" FontSize="14" LineHeight="20"
                                           Text="Änderungen an Anwendungsdaten können zu Datenverlust oder Fehlfunktionen führen."/>
                            </Grid>
                        </Border>
                        <Button Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="&#xED25;" FontSize="16" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Label Content="Anwendungsdaten öffnen" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- Lizenz / Copyright (Fußnote) -->
            <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                    <TextBlock Text="Lizenz" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="22"
                               Text="KerwaKasse ist Open Source und steht unter der Apache License 2.0."/>
                    <TextBlock FontSize="15" Margin="0,10,0,0">
                        <Hyperlink Command="{Binding OpenRepositoryCommand}">Projekt auf GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="15" Margin="0,4,0,0">
                        <Hyperlink Command="{Binding OpenThirdPartyNoticesCommand}">Verwendete Open-Source-Komponenten</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Copyright}" Foreground="#707070" FontSize="14" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
