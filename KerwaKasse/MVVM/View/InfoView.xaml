<UserControl x:Class="KerwaKasse.MVVM.View.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KerwaKasse.MVVM.View"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="750">
    <UserControl.Resources>
        <!-- Light card used to group the sections on the page. A full 1px border
             defines all four edges (a directional drop shadow alone made the left
             and top edges blend into the page background). -->
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E3E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,16,20,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,10,20,10">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Info" Foreground="Black" FontSize="30" Margin="0,0,0,20"/>

            <!-- Header: app identity + version -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Image Source="/Assets/KerwaKasse.png" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KerwaKasse" Foreground="Black" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Version}" Foreground="#707070" FontSize="15" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Über die App -->
            <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                    <TextBlock Text="Über die App" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="22"
                               Text="KerwaKasse unterstützt den bargeldbasierten Verkauf bei Vereinsveranstaltungen, insbesondere im Gastronomiebereich. Die Anwendung erleichtert ehrenamtlichen Helfern die Arbeit an der Bargeldkasse: Bestellungen lassen sich schnell per Klick zusammenstellen, Preise werden automatisch berechnet und die erfassten Verkäufe können im Nachgang ausgewertet werden."/>
                    <Border Background="#FBF5E6" BorderBrush="#EBD9A8" BorderThickness="1" CornerRadius="4"
                            Padding="12,10,12,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B8860B"
                                       VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#6B5A22" FontSize="14" LineHeight="20"
                                       Text="Kein zertifiziertes, TSE-konformes Kassensystem; nicht für den regulären gewerblichen Betrieb vorgesehen."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Datensicherung -->
            <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                    <TextBlock Text="Datensicherung" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="22"
                               Text="Erstellt eine Sicherungskopie der Datenbank. Es wird empfohlen, diese auf einem externen Speichermedium (z. B. USB-Stick) oder auf einem separaten Datenträger zu speichern."/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Command="{Binding BackupCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <Path Fill="White" Stretch="Uniform"
                                              Data="M64 128C64 110.3 78.3 96 96 96L544 96C561.7 96 576 110.3 576 128L576 160C576 177.7 561.7 192 544 192L96 192C78.3 192 64 177.7 64 160L64 128zM96 240L544 240L544 480C544 515.3 515.3 544 480 544L160 544C124.7 544 96 515.3 96 480L96 240zM248 304C234.7 304 224 314.7 224 328C224 341.3 234.7 352 248 352L392 352C405.3 352 416 341.3 416 328C416 314.7 405.3 304 392 304L248 304z"/>
                                    </Viewbox>
                                    <Label Content="Backup erstellen" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="&#xE8E5;" FontSize="16" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Label Content="Wiederherstellen" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Entwickler (eingeklappt) -->
            <Border Style="{StaticResource InfoCard}">
                <Expander Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <TextBlock Text="Erweitert" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="#FBF5E6" BorderBrush="#EBD9A8" BorderThickness="1" CornerRadius="4"
                                Padding="12,10,12,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B8860B"
                                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#6B5A22" FontSize="14" LineHeight="20"
                                           Text="Änderungen an Anwendungsdaten können zu Datenverlust oder Fehlfunktionen führen."/>
                            </Grid>
                        </Border>
                        <Button Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="&#xED25;" FontSize="16" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Label Content="Anwendungsdaten öffnen" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- Lizenz / Copyright (Fußnote) -->
            <Border Style="{StaticResource InfoCard}">
                <StackPanel>
                    <TextBlock Text="Lizenz" Foreground="Black" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="22"
                               Text="Keine offene Lizenz vergeben; alle Rechte vorbehalten."/>
                    <TextBlock Text="{Binding Copyright}" Foreground="#707070" FontSize="14" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
