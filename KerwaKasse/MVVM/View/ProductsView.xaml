<UserControl x:Class="KerwaKasse.MVVM.View.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:helper="clr-namespace:KerwaKasse.Helper"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000">

    <UserControl.Resources>
        <helper:DoubleToGridLengthConverter x:Key="DoubleToGridLength"/>
        <helper:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <helper:FixedColorBorderConverter x:Key="FixedColorBorder"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Validation: keep the field in place, show errors manually below -->
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <AdornedElementPlaceholder/>
        </ControlTemplate>

        <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationErrorTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared appearance for the list column headers and the edit-panel field captions.
             The look is defined once here; margins stay on each element. -->
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8F96"/>
        </Style>

        <!-- Field caption in the edit panel: shared look + a consistent label-to-field gap. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Prices use a monospace face so the digits line up and stand out a little. -->
        <FontFamily x:Key="PriceFont">Cascadia Mono, Consolas</FontFamily>

        <!-- Speisekarten dropdown trigger: subtle when no card is active, tinted blue when one is.
             Custom template so the active tint survives hover (the default button reverts on hover). -->
        <Style x:Key="MenuPillButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <!-- Accent ring while open: overlaid so its thickness never shifts the content. -->
                            <Border x:Name="accent" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="Transparent" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1.5"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="open">
                                <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasActiveMenu}" Value="True">
                    <Setter Property="Background" Value="#E4EAF1"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A row inside the Speisekarten flyout: transparent, grey hover, blue when it is the active card. -->
        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F2F4"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E4EAF1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle outline buttons for the reorder actions (white fill, thin border).
             When disabled (the top/bottom item) the button is hidden rather than greyed — a greyed
             default-button background would look more prominent than this subtle enabled style.
             Hidden (not Collapsed) keeps the sibling button in place. -->
        <Style x:Key="MoveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#3A4750"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Table row: adjoining rows with a bottom divider; selection adds a left accent bar. -->
        <Style x:Key="ProductRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent"
                                BorderBrush="#EDEFF2" BorderThickness="0,0,0,1">
                            <Grid>
                                <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Available}" Value="False">
                                <Setter TargetName="Row" Property="Background" Value="#E9EBEE"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E2ECF7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#CFE0F2"/>
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainGrid" Margin="12" PreviewMouseDown="Root_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="{Binding SidePanelWidth, Converter={StaticResource DoubleToGridLength}, FallbackValue=440}"/>
        </Grid.ColumnDefinitions>

        <!-- Header: title + product search + Speisekarten dropdown (top-right) -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="4,0,4,12">
            <TextBlock Text="Produkte" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- Product search (filters the list; manual placeholder stays vertically centered) -->
                <Grid Width="210" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="White"
                             FontSize="15" Height="42" VerticalContentAlignment="Center" Padding="36,0,10,0"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8B929E"
                               IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="13,0,0,0"/>
                    <TextBlock Text="Produkt suchen …" Foreground="#9AA0A6" FontSize="15" IsHitTestVisible="False"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="38,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Divider between search and Speisekarte -->
                <Border Width="1" Background="#E0E3E7" Margin="16,7"/>

                <TextBlock Text="Speisekarte" FontSize="16" Foreground="#909090"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="MenuButton" Style="{StaticResource MenuPillButton}" Width="210" Height="42"
                        ToolTipService.ToolTip="Speisekarte anwenden oder verwalten">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding HasActiveMenu, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Grid.Column="1" FontSize="15" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ActiveMenuText, TargetNullValue='Keine aktiv', FallbackValue='Keine aktiv'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveMenu}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                    </Grid>
                    <ui:FlyoutService.Flyout>
                        <ui:Flyout Placement="BottomEdgeAlignedRight" Opened="MenuFlyout_Opened" Closed="MenuFlyout_Closed">
                            <ui:Flyout.FlyoutPresenterStyle>
                                <Style TargetType="ui:FlyoutPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ui:Flyout.FlyoutPresenterStyle>
                            <DockPanel Width="280">
                                <!-- Header banner (active status) -->
                                <Border DockPanel.Dock="Top" Background="#F7F8FA" CornerRadius="8,8,0,0"
                                        BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="SPEISEKARTE" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8F96"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="14"
                                                   Visibility="{Binding HasActiveMenu, Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="Aktiv: " Foreground="#8A8F96"/><Run Text="{Binding ActiveMenuText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="Keine Speisekarte aktiv" Margin="0,4,0,0" FontSize="14" Foreground="#8A8F96"
                                                   Visibility="{Binding HasActiveMenu, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Footer banner (manage) -->
                                <Border DockPanel.Dock="Bottom" Background="#F7F8FA" CornerRadius="0,0,8,8"
                                        BorderBrush="#EDEFF2" BorderThickness="0,1,0,0" Padding="6">
                                    <Button Style="{StaticResource MenuRowButton}" Click="ManageMenus_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource LayersIcon}" Stroke="#586070" StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Speisekarten verwalten …" FontSize="14.5" Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- Menu list (white) -->
                                <Grid Margin="6">
                                    <TextBlock Text="Noch keine Speisekarten" FontSize="14" Foreground="#9AA0A6" Margin="6,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Menus.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                        <ItemsControl ItemsSource="{Binding MenuOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MenuRowButton}" Click="MenuOption_Click" Margin="0,1">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="#1B1E24" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </ui:Flyout>
                    </ui:FlyoutService.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Product list (table, left) -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"
                CornerRadius="8" Background="White" BorderBrush="#E0E3E7" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.07" Color="Black"/>
            </Border.Effect>
            <DockPanel>
                <!-- Header row -->
                <Border DockPanel.Dock="Top" BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="0,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUKT" Style="{StaticResource CaptionText}"
                                   Margin="17,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="PREIS" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="VERFÜGBAR" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Product rows (empty-state overlays the list area; the header row above stays) -->
                <Grid>
                <ListBox ItemsSource="{Binding Products}"
                         SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ProductRowStyle}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="0,0,0,2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- Colour swatch + name -->
                                <Grid Grid.Column="0" Margin="14,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Swatch" Grid.Column="0" Width="14" Height="14" CornerRadius="4"
                                            Background="{Binding ColorBrush}" BorderThickness="1"
                                            BorderBrush="{Binding ColorBrush, Converter={StaticResource FixedColorBorder}}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#222222"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- Price -->
                                <TextBlock x:Name="PriceText" Grid.Column="1" Text="{Binding Price, StringFormat={}{0:C}}"
                                           FontFamily="{StaticResource PriceFont}"
                                           FontSize="15" Foreground="#555555" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>

                                <!-- Availability toggle (never greyed out), centered under the column -->
                                <ui:ToggleSwitch Grid.Column="2" IsOn="{Binding Available, Mode=TwoWay}"
                                                 OnContent="" OffContent="" MinWidth="0" Width="44"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                                    <ui:ToggleSwitch.LayoutTransform>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                    </ui:ToggleSwitch.LayoutTransform>
                                </ui:ToggleSwitch>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Available}" Value="False">
                                    <Setter TargetName="NameText" Property="Foreground" Value="#9AA0A6"/>
                                    <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
                                    <Setter TargetName="PriceText" Property="Foreground" Value="#AEB3B8"/>
                                    <Setter TargetName="Swatch" Property="Opacity" Value="0.3"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state: no products exist yet -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="46" Foreground="#C0C0C0"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="Noch keine Produkte" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Legen Sie rechts über „Neues Produkt“ Ihr erstes Produkt an."
                               FontSize="14" Foreground="#909090" HorizontalAlignment="Center" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"/>
                </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Splitter (gap matches the outer margin) -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="12"
                      HorizontalAlignment="Stretch" Background="Transparent"
                      DragCompleted="GridSplitter_DragCompleted"/>

        <!-- Right-hand area -->

        <!-- Mode 1: placeholder -->
        <Border Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                CornerRadius="8" Background="White" BorderBrush="#E0E3E7" BorderThickness="1"
                Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.07" Color="Black"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                           Foreground="#C0C0C0" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="Kein Produkt ausgewählt" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="Wählen Sie links ein Produkt aus, um es zu bearbeiten, oder legen Sie ein neues an."
                           FontSize="14" Foreground="#909090" HorizontalAlignment="Center"
                           Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"/>
                <Button Command="{Binding AddProductCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,26,0,0" Padding="22,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Neues Produkt" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Mode 2: detail / edit -->
        <Border Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                CornerRadius="8" Background="White" BorderBrush="#E0E3E7" BorderThickness="1"
                Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.07" Color="Black"/>
            </Border.Effect>
            <DockPanel>

                <!-- Header with divider + unsaved-state chip -->
                <Border DockPanel.Dock="Top" BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="18,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Produkt bearbeiten"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddingNew}" Value="True">
                                            <Setter Property="Text" Value="Neues Produkt anlegen"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Grid.Column="1" VerticalAlignment="Center"
                                Background="#FFF4DE" CornerRadius="10" Padding="9,3"
                                Visibility="{Binding DetailPanel.HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#D69E2E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DetailPanel.UnsavedChipText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#8A6D17" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer with divider + offset background (rounded bottom corners) -->
                <Border DockPanel.Dock="Bottom" Background="#F7F8FA" CornerRadius="0,0,7,7"
                        BorderBrush="#EDEFF2" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding DiscardDetailCommand}"
                                HorizontalAlignment="Stretch" Height="44" FontSize="16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Verwerfen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding SaveDetailCommand}"
                                Style="{StaticResource CustomAccentButtonStyle}"
                                HorizontalAlignment="Stretch" Height="44" FontSize="16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Speichern" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Form (even spacing via groups with a constant bottom margin) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16">

                        <!-- Name -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NameTextBox" Grid.Column="0"
                                         Text="{Binding DetailPanel.Name, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged,
                                                        ValidatesOnDataErrors=True}"
                                         IsEnabled="{Binding DetailPanel.NameUnlocked}"
                                         Style="{StaticResource ValidatedTextBox}"
                                         FontSize="16" Margin="0,0,8,0" MaxLength="30"/>
                                <Button Grid.Column="1"
                                        Visibility="{Binding DetailPanel.UnlockButtonVisible,
                                                             Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding ToggleNameLockCommand}"
                                        ToolTip="{Binding DetailPanel.LockTooltip}"
                                        VerticalAlignment="Stretch" Width="44" Padding="0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <!-- Unlocked name: lock button in warning colour -->
                                                <DataTrigger Binding="{Binding DetailPanel.NameUnlocked}" Value="True">
                                                    <Setter Property="Background" Value="#FFF3D6"/>
                                                    <Setter Property="BorderBrush" Value="#F0C24B"/>
                                                    <Setter Property="Foreground" Value="#B7791F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding DetailPanel.LockGlyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <!-- Error + character counter -->
                            <Grid Margin="0,5,0,0">
                                <TextBlock FontSize="12" Foreground="#E53935"
                                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=NameTextBox}"
                                           Visibility="{Binding (Validation.HasError), ElementName=NameTextBox,
                                                                Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock FontSize="12" Foreground="#A0A0A0" HorizontalAlignment="Right"
                                           Text="{Binding DetailPanel.Name.Length, FallbackValue=0,
                                                          StringFormat={}{0} / 30}"/>
                            </Grid>
                            <!-- Warning banner: only when an existing name is unlocked -->
                            <Border CornerRadius="6" Background="#FFF8E7" BorderBrush="#F0C24B" BorderThickness="1"
                                    Padding="10,8" Margin="0,8,0,0"
                                    Visibility="{Binding DetailPanel.NameWarningVisible, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" Foreground="#B7791F" VerticalAlignment="Top" Margin="0,1,9,0"/>
                                    <TextBlock Text="{Binding DetailPanel.NameHint}" FontSize="12.5" Foreground="#8A6D17"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Price -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="PREIS" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <TextBox x:Name="PriceTextBox"
                                         Text="{Binding DetailPanel.PriceText, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged,
                                                        ValidatesOnDataErrors=True}"
                                         Style="{StaticResource ValidatedTextBox}"
                                         FontFamily="{StaticResource PriceFont}" FontSize="16"
                                         VerticalContentAlignment="Center"
                                         MinHeight="{Binding ActualHeight, ElementName=NameTextBox}"
                                         Padding="30,5,8,5"/>
                                <!-- Static, non-editable euro sign overlay – same font/size and centered
                                     like the price so the two sit on one line. -->
                                <TextBlock Text="&#x20AC;" IsHitTestVisible="False" Foreground="#8A8F96"
                                           FontFamily="{StaticResource PriceFont}" FontSize="16"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock FontSize="12" Foreground="#E53935" Margin="0,5,0,0"
                                       Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=PriceTextBox}"
                                       Visibility="{Binding (Validation.HasError), ElementName=PriceTextBox,
                                                            Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- Colour -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="FARBE" Style="{StaticResource FieldLabel}"/>
                            <xctk:ColorPicker SelectedColor="{Binding DetailPanel.ColorAsString, Mode=TwoWay}"
                                              UsingAlphaChannel="False" Height="40"/>
                        </StackPanel>

                        <!-- Availability (box colour reflects state) -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="VERFÜGBARKEIT" Style="{StaticResource FieldLabel}"/>
                            <Border CornerRadius="3" BorderThickness="1" Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F3F5"/>
                                        <Setter Property="BorderBrush" Value="#E0E3E7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailPanel.Available}" Value="True">
                                                <Setter Property="Background" Value="#EAF1FB"/>
                                                <Setter Property="BorderBrush" Value="#BCD4F0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Left" IsOn="{Binding DetailPanel.Available, Mode=TwoWay}"
                                                     OnContent="" OffContent="" MinWidth="0" Width="44" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailPanel.AvailabilityText}" FontSize="15"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sort order (hidden when adding a new product) -->
                        <StackPanel Visibility="{Binding IsAddingNew, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="REIHENFOLGE" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource MoveButton}" Command="{Binding MoveSelectedUpCommand}"
                                            ToolTip="Nach oben verschieben" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Nach oben" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MoveButton}" Command="{Binding MoveSelectedDownCommand}"
                                            ToolTip="Nach unten verschieben">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Nach unten" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- Position indicator: clicking it swaps to a text box for direct position input. -->
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CurrentPositionText}" FontSize="14" Foreground="#8A8F96"
                                               VerticalAlignment="Center" Cursor="Hand"
                                               ToolTip="Klicken, um die Position direkt einzugeben"
                                               Visibility="{Binding IsEditingPosition, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding BeginPositionEditCommand}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <TextBox x:Name="PositionInputBox" Width="56" FontSize="14" VerticalAlignment="Center"
                                             TextAlignment="Center" VerticalContentAlignment="Center"
                                             Text="{Binding PositionInput, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditingPosition, Converter={StaticResource BoolToVisibility}}"
                                             IsVisibleChanged="PositionInputBox_IsVisibleChanged"
                                             PreviewKeyDown="PositionInputBox_PreviewKeyDown"
                                             PreviewTextInput="PositionInputBox_PreviewTextInput"
                                             LostFocus="PositionInputBox_LostFocus"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
