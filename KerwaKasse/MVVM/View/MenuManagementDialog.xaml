<ui:ContentDialog x:Class="KerwaKasse.MVVM.View.MenuManagementDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:helper="clr-namespace:KerwaKasse.Helper"
             mc:Ignorable="d"
             Padding="0"
             d:DesignHeight="800" d:DesignWidth="600">

    <ui:ContentDialog.Resources>
        <!-- Full-bleed content (remove the default ContentDialog inset) and allow the wide layout. -->
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <sys:Double x:Key="ContentDialogMaxWidth">980</sys:Double>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helper:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Small uppercase section caption. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B929E"/>
        </Style>

        <!-- Inline validation: keep the field in place, show the message manually below. -->
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <AdornedElementPlaceholder/>
        </ControlTemplate>
        <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationErrorTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Speisekarten row: rounded selection highlight, no icon. -->
        <Style x:Key="MenuListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E5EA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D7DEE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid red button (delete confirmation in the flyout). -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#922B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reorder buttons: subtle outline; hidden (not greyed) at the list boundary so the
             non-working direction simply disappears. -->
        <Style x:Key="MoveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#3A4750"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Subtle accent "link" button for Alle/Keine. -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E5EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:ContentDialog.Resources>

    <!-- Height is the comfortable target on large screens; MaxHeight is capped in
         code-behind to the host window so the content shrinks (sidebar list / product
         list give up space first) instead of being clipped on small monitors. -->
    <Grid x:Name="RootGrid" Width="700" Height="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══════════════════════════════════════════════ -->
        <!-- Clicking the header (empty area / title, not the close button) clears the selection. -->
        <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DeselectArea_MouseDown"
                BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="22,8,22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource LayersIcon}" Stroke="{DynamicResource AppAccentBrush}"
                      StrokeThickness="1.5" StrokeLineJoin="Round" Width="22" Height="22"
                      Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Speisekarten verwalten" FontSize="21" FontWeight="SemiBold"
                           Foreground="#1B1E24" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="2" Click="CloseButton_Click" Background="Transparent" BorderThickness="0"
                        Width="40" Height="40" Padding="0" Cursor="Hand" ToolTip="Schließen">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#586070"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Body ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Sidebar ─────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="#ECEFF3" BorderBrush="#E2E5EA" BorderThickness="0,0,1,0"
                    CornerRadius="0,0,0,8">
                <DockPanel>
                    <!-- New menu (accent) — only when at least one exists; empty state has its own. -->
                    <Border DockPanel.Dock="Bottom" Padding="14"
                            Visibility="{Binding HasMenus, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding AddMenuCommand}" Style="{StaticResource CustomAccentButtonStyle}"
                                HorizontalAlignment="Stretch" Height="44">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Neue Speisekarte" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Grid>
                        <!-- Speisekarten list (clicking empty space clears the selection) -->
                        <ListBox ItemsSource="{Binding Menus}"
                                 SelectedItem="{Binding SelectedMenu}"
                                 ItemContainerStyle="{StaticResource MenuListItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonDown="SidebarList_MouseDown"
                                 Visibility="{Binding HasMenus, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NameTb" Grid.Column="0" Text="{Binding Name}" FontSize="16"
                                                   Foreground="#1B1E24" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CountTb" Grid.Column="1" Text="{Binding ProductCount}"
                                                   FontSize="14" Foreground="#8B929E" VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="NameTb" Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                            <Setter TargetName="NameTb" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="CountTb" Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                            <Setter TargetName="CountTb" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Sidebar empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasMenus, Converter={StaticResource InverseBoolToVisibility}}">
                            <Path Data="{StaticResource LayersIcon}" Stroke="#AAB0BA" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" Width="40" Height="40" Stretch="Uniform"
                                  HorizontalAlignment="Center"/>
                            <TextBlock Text="Noch keine Speisekarten" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#1B1E24" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="Legen Sie eine Speisekarte an, um mehrere Produkte gemeinsam verfügbar zu schalten."
                                       FontSize="13" Foreground="#8B929E" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="200"/>
                            <Button Command="{Binding AddMenuCommand}" Style="{StaticResource CustomAccentButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Speisekarte anlegen" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ─── Right pane ──────────────────────────────────────── -->
            <Grid Grid.Column="1">

                <!-- Empty: no menu selected -->
                <TextBlock Text="Keine Speisekarte ausgewählt" Foreground="#8B929E" FontSize="15"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding HasMenuSelected, Converter={StaticResource InverseBoolToVisibility}}"/>

                <!-- Detail: edit selected menu -->
                <DockPanel Visibility="{Binding HasMenuSelected, Converter={StaticResource BoolToVisibility}}">

                    <!-- Footer (only while there are unsaved changes) -->
                    <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#EDEFF2"
                            BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,8,0"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Verwerfen" Command="{Binding DiscardCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="#586070"
                                    Padding="14,8" FontSize="15" Cursor="Hand" VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Command="{Binding SaveCommand}"
                                    Style="{StaticResource CustomAccentButtonStyle}" Padding="20,9">
                                <TextBlock Text="Speichern" FontSize="15" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Everything above the footer scrolls together once the dialog is squeezed
                         too short to show it all. The inner panel's Height tracks the viewport, so on
                         normal/large windows nothing scrolls here (the search stays put and the
                         product list keeps its own inner scroll); MinHeight only forces the outer
                         scrollbar when the window gets very small. -->
                    <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
                    <DockPanel MinHeight="400" Height="{Binding ViewportHeight, ElementName=DetailScroller}">

                    <!-- Name -->
                    <StackPanel DockPanel.Dock="Top" Margin="26,22,26,0">
                        <!-- The chip is taller than the label; negative vertical margins keep it from
                             growing the row, so the label-to-field gap matches the other section and
                             toggling the chip never shifts the controls below. -->
                        <Grid>
                            <TextBlock Text="NAME DER SPEISEKARTE" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <!-- Unsaved chip (shown together with the footer) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-4,0,-4"
                                    Background="#FFF4DE" CornerRadius="10" Padding="9,3"
                                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#D69E2E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Geändert" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#8A6D17" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NameBox" Grid.Column="0"
                                     Text="{Binding MenuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Style="{StaticResource ValidatedTextBox}" MaxLength="30"
                                     FontSize="16" Height="40" VerticalContentAlignment="Center" Padding="12,0"/>
                            <Button Grid.Column="1" x:Name="DeleteButton" Width="44" Height="40" Margin="10,0,0,0"
                                    Padding="0" Background="White" BorderBrush="#E3B5B0" BorderThickness="1"
                                    ToolTip="Speisekarte löschen">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#C0392B"/>
                                <ui:FlyoutService.Flyout>
                                    <ui:Flyout Placement="Bottom">
                                        <StackPanel MaxWidth="240">
                                            <TextBlock Text="Diese Speisekarte wirklich löschen?" TextWrapping="Wrap"
                                                       FontSize="14" Foreground="#1B1E24"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                                <Button Content="Abbrechen" Click="CancelDelete_Click"
                                                        Padding="14,6" Margin="0,0,8,0"/>
                                                <Button Content="Löschen" Click="ConfirmDelete_Click"
                                                        Style="{StaticResource DangerButton}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Flyout>
                                </ui:FlyoutService.Flyout>
                            </Button>
                        </Grid>
                        <!-- Error message (only when invalid) -->
                        <TextBlock FontSize="12" Foreground="#E53935" Margin="0,5,0,0"
                                   Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=NameBox}"
                                   Visibility="{Binding (Validation.HasError), ElementName=NameBox, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- Reorder the selected card (option C: in the right panel, like the products view) -->
                    <StackPanel DockPanel.Dock="Top" Margin="26,16,26,0">
                        <TextBlock Text="REIHENFOLGE" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource MoveButton}" Command="{Binding MoveMenuUpCommand}"
                                        Padding="16,0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Nach oben" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MoveButton}" Command="{Binding MoveMenuDownCommand}" Padding="16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Nach unten" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedMenuPositionText}" FontSize="12.5" Foreground="#8A8F96"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="26,16,26,0">
                        <Button DockPanel.Dock="Right" Command="{Binding ClearProductsCommand}" Content="Keine"
                                Style="{StaticResource SmallActionButton}"/>
                        <Button DockPanel.Dock="Right" Command="{Binding SelectAllProductsCommand}" Content="Alle"
                                Style="{StaticResource SmallActionButton}" Margin="0,0,4,0"/>
                        <TextBlock Text="PRODUKTE ZUORDNEN" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Search (manual placeholder so it stays vertically centered) -->
                    <Grid DockPanel.Dock="Top" Margin="26,8,26,0">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" Height="40" VerticalContentAlignment="Center" Padding="38,0,12,0"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#8B929E"
                                   IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="14,0,0,0"/>
                        <TextBlock Text="Produkt suchen …" Foreground="#9AA0A6" FontSize="15" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Product list (checkbox + name only) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="26,12,20,6">
                        <ItemsControl ItemsSource="{Binding FilteredMenuProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                              FontSize="15" Foreground="#1B1E24" VerticalContentAlignment="Center"
                                              MinHeight="36" Margin="0,1" Padding="10,0,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </DockPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:ContentDialog>
