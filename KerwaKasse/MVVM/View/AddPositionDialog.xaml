<ui:ContentDialog x:Class="KerwaKasse.MVVM.View.AddPositionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KerwaKasse.MVVM.View"
             xmlns:helper="clr-namespace:KerwaKasse.Helper"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d"
             Padding="0">
    <ui:ContentDialog.Resources>
        <!-- The content brings its own inset, so the X can sit close to the corner without being clipped. -->
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <helper:FixedColorBorderConverter x:Key="FixedColorBorder"/>
        <helper:ProductPriceTextConverter x:Key="ProductPriceText"/>
        <FontFamily x:Key="PriceFont">Cascadia Mono, Consolas</FontFamily>
    </ui:ContentDialog.Resources>

    <!-- No ContentDialog buttons: the dialog brings its own, touch-sized one (on the right) and closes
         with the X, Escape or a tap next to it, like the till's dialogs. -->
    <Grid Width="408">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,18,12,10">
            <TextBlock Text="Position nachtragen" FontSize="21" FontWeight="SemiBold" Foreground="#1B1E24"
                       VerticalAlignment="Center" Margin="0,0,48,0"/>
            <Button Click="Close_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                    HorizontalAlignment="Right" Cursor="Hand" ToolTip="Schließen" AutomationProperties.Name="Schließen">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#586070"/>
            </Button>
        </Grid>

        <ListBox x:Name="OptionList" Grid.Row="1" Margin="12,0,6,0" MaxHeight="400" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" Padding="0,0,18,0"
                 SelectionChanged="OptionList_SelectionChanged"
                 MouseDoubleClick="OptionList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Padding" Value="12,9"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <StackPanel>
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <!-- "Freie Eingabe" comes first and is set apart from the products. -->
                                    <Border x:Name="Divider" Height="1" Background="#E3E6EA" Margin="0,6,0,4" Visibility="Collapsed"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFreeEntry}" Value="True">
                                        <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E2E5EA"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#D7DEE8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="4" Margin="0,0,12,0"
                                Background="{Binding Color}" BorderThickness="1" VerticalAlignment="Center"
                                BorderBrush="{Binding Color, Converter={StaticResource FixedColorBorder}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- Empty for "Freie Eingabe": its amount is entered next. -->
                        <TextBlock Grid.Column="2" FontSize="15"
                                   FontFamily="{StaticResource PriceFont}"
                                   Foreground="#707070" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ProductPriceText}">
                                    <Binding Path="Product.Price"/>
                                    <Binding Path="Product.VariablePrice"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Height="50" Margin="24,18,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Available once an entry is selected. -->
            <Button x:Name="AddButton" Grid.Column="2" Style="{StaticResource SidebarActionButton}" Click="Add_Click"
                    IsEnabled="False">
                <TextBlock Text="Hinzufügen" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
            </Button>
        </Grid>
    </Grid>
</ui:ContentDialog>
