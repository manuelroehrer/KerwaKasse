<UserControl x:Class="KerwaKasse.MVVM.View.OrderPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KerwaKasse.MVVM.View"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:helper="clr-namespace:KerwaKasse.Helper"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <helper:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter"/>
        <helper:BrushColoredBorderConverter x:Key="BrushColoredBorderConverter"/>

        <!-- Captures this view's DataContext so the tiles' ScaleTransform (not in the visual tree,
             so RelativeSource FindAncestor cannot reach the view model) can bind the scale factor. -->
        <helper:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>

        <FontFamily x:Key="PriceFont">Cascadia Mono, Consolas</FontFamily>

        <!-- Quiet icon button on each order row (minus, or an X at amount 1). Kept grey and
             borderless because it sits on every row; hover/pressed like the settings gear. -->
        <Style x:Key="DecreaseButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Eins weniger"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="Transparent" CornerRadius="5">
                            <TextBlock x:Name="Icon" Text="&#xE738;" FontSize="20"
                                       FontFamily="Segoe MDL2 Assets" Foreground="#8A8F96"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Amount}" Value="1">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE711;"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#0A000000"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#14000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Amount}" Value="1">
                    <Setter Property="ToolTip" Value="Position entfernen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="{Binding OrderPanelWidth, Converter={StaticResource DoubleToGridLengthConverter}, FallbackValue=350}" MinWidth="280" MaxWidth="600"/>
        </Grid.ColumnDefinitions>

        <!-- Product grid. Uniform padding: together with the uniform tile margin (4) this yields the
             same 10px gap to the nav bar, the title bar and the panel edges. -->
        <ScrollViewer x:Name="ProductScroll"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="6"
                      SizeChanged="ProductScroll_SizeChanged">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Path=DataContext.AddOrderPositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Data.EffectiveScaleFactor, Source={StaticResource ViewModelProxy}}"
                                                ScaleY="{Binding Data.EffectiveScaleFactor, Source={StaticResource ViewModelProxy}}"/>
                            </Button.LayoutTransform>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- Keep the auto-fit footprint constants in OrderPanelViewModel in sync
                                         with this size and margin (170+8 × 105+8). -->
                                    <Border x:Name="Card" Width="170" Height="105" CornerRadius="5" Background="White" Margin="4"
                                            BorderThickness="0.9" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                        <Border.BorderBrush>
                                            <MultiBinding Converter="{StaticResource BrushColoredBorderConverter}">
                                                <Binding Path="Color"/>
                                                <Binding Path="DataContext.BorderDarkenFactor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                <Binding Path="DataContext.UseColoredBorder" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Border.BorderBrush>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.18" Color="Black"/>
                                        </Border.Effect>
                                        <Grid ClipToBounds="True">
                                            <Border Background="{Binding Color}" VerticalAlignment="Top"
                                                    Height="18" CornerRadius="4,4,0,0"
                                                    BorderThickness="0,0,0,0.9">
                                                <Border.BorderBrush>
                                                    <MultiBinding Converter="{StaticResource BrushColoredBorderConverter}">
                                                        <Binding Path="Color"/>
                                                        <Binding Path="DataContext.BorderDarkenFactor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="DataContext.UseColoredBorder" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.BorderBrush>
                                            </Border>

                                            <!-- Hover overlay -->
                                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="5"/>

                                            <!-- Content -->
                                            <StackPanel VerticalAlignment="Center" Margin="15,19,14,6">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#1A1A1A"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           FontSize="20"
                                                           MaxHeight="54"
                                                           helper:AutoFitTextBlock.Enabled="True"
                                                           helper:AutoFitTextBlock.MaxFontSize="20"
                                                           helper:AutoFitTextBlock.MinFontSize="11"/>
                                                <TextBlock Text="{Binding Price, StringFormat={}{0:C}}"
                                                           Foreground="#606060"
                                                           FontFamily="{StaticResource PriceFont}"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#08000000" TargetName="Overlay"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#12000000" TargetName="Overlay"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state: no products available to order -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Products.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#C0C0C0"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="Keine Produkte verfügbar" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Im Bereich „Produkte“ können Sie Produkte anlegen und verfügbar schalten."
                       FontSize="14" Foreground="#909090" HorizontalAlignment="Center" Margin="0,8,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
        </StackPanel>

        <!-- Success notification toast -->
        <Grid Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Margin="0,0,0,16" Panel.ZIndex="10">
            <Border Background="#74AD3F" CornerRadius="5" Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Foreground="White" FontSize="18" FontFamily="Segoe MDL2 Assets"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Bestellung erfolgreich gespeichert" Foreground="White" FontSize="16"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2.5" Direction="270" Opacity="0.22" Color="Black"/>
                </Border.Effect>
            </Border>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowNotification}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>

        <!-- Divider + splitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                      Background="#cdcdcd" DragCompleted="GridSplitter_DragCompleted"/>

        <!-- Order panel -->
        <Border Grid.Column="2" Background="White">
            <DockPanel LastChildFill="True">

                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="16,14,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bestellung" FontWeight="Bold" FontSize="27" VerticalAlignment="Center"/>

                    <!-- Settings gear button with Flyout -->
                    <Button Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" ToolTip="UI-Anpassungen">
                        <ui:FlyoutService.Flyout>
                            <ui:Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="270">
                                    <TextBlock Text="Größe der Produkt-Buttons" Foreground="#1B1E24" FontSize="14"
                                               FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <!-- Auto-fit on top: the default mode. Its slider caps how large the
                                         tiles may grow when only a few products are available. -->
                                    <DockPanel>
                                        <ui:ToggleSwitch DockPanel.Dock="Left" IsOn="{Binding AutoFitTiles, Mode=TwoWay}"
                                                         OnContent="" OffContent="" MinWidth="0" Width="44"
                                                         VerticalAlignment="Center"/>
                                        <TextBlock Text="Automatisch einpassen" FontSize="13" Foreground="#444"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   ToolTip="Wählt die Größe automatisch so, dass alle Produkte ohne Scrollen sichtbar sind"/>
                                    </DockPanel>
                                    <TextBlock Text="Maximale Größe" FontSize="12" Foreground="#8A8F96" Margin="0,10,0,2"/>
                                    <!-- Starts at ~1/3 of the track: a very low upper bound would only ever shrink
                                         the tiles and never be picked, so the useful range begins higher. -->
                                    <Slider Minimum="1.14" Maximum="2.5" Value="{Binding AutoFitMaxFactor}"
                                            Thumb.DragCompleted="MaxFactorSlider_DragCompleted"
                                            IsEnabled="{Binding AutoFitTiles}"
                                            ToolTip="Obergrenze für die automatische Vergrößerung bei wenigen Produkten"/>

                                    <Border Height="1" Background="#E4E6E9" Margin="0,14,0,12"/>

                                    <TextBlock Text="Manuelle Größe" FontSize="12" Foreground="#8A8F96" Margin="0,0,0,2"/>
                                    <Slider Minimum="0.5" Value="{Binding Button_ResizeFactor}" Maximum="2.5"
                                            Thumb.DragCompleted="Slider_DragCompleted"
                                            IsEnabled="{Binding IsManualTileSize}"
                                            ToolTip="Feste Größe der Produkt-Buttons (nur ohne automatisches Einpassen)"/>
                                </StackPanel>
                            </ui:Flyout>
                        </ui:FlyoutService.Flyout>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBg" Background="Transparent" CornerRadius="4" Padding="6">
                                    <TextBlock x:Name="AdjustIcon" Text="&#xE9E9;" FontSize="22"
                                               FontFamily="Segoe MDL2 Assets" Foreground="#666"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBg" Property="Background" Value="#0A000000"/>
                                        <Setter TargetName="AdjustIcon" Property="Foreground" Value="#333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBg" Property="Background" Value="#14000000"/>
                                        <Setter TargetName="AdjustIcon" Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Total + action buttons (docked to bottom) -->
                <Border DockPanel.Dock="Bottom" Background="#EFF0F2" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Padding="16,16,16,18">
                    <StackPanel>
                        <!-- Total row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gesamt" FontWeight="Medium" FontSize="22" Foreground="#616161" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            <!-- Total intentionally in the darker sidebar tone, not the accent colour: see the save button below. -->
                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:C}}"
                                       FontWeight="Bold" FontSize="32" Foreground="{DynamicResource AppSidebarBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Action buttons -->
                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <!-- Discard: red outline like the delete button in the history, so the only
                                 destructive action without a confirmation reads as such, while staying
                                 secondary to the filled save button. -->
                            <Button Command="{Binding DiscardOrderCommand}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand"
                                    ToolTip="Bestellung verwerfen">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" SnapsToDevicePixels="True"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="White" BorderBrush="#E3B5B0" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FBF0EF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#D99C95"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F1E1E1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#C0392B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <!-- Save button: intentionally in the darker sidebar tone (AppSidebarBrush)
                                 instead of the accent colour. In the order panel this is the only accent
                                 control on screen next to the dark title bar and the even darker nav bar,
                                 so a third, lighter blue looked off; other views show enough accent
                                 controls for the accent colour to sit right there. Hover/pressed are
                                 derived from the base tone at runtime by overlaying a translucent veil
                                 (same idiom as the product tiles above), so no extra colour constants
                                 are needed and the disabled state simply dims. -->
                            <Button Grid.Column="2" Command="{Binding SaveOrderCommand}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" SnapsToDevicePixels="True"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource AppSidebarBrush}">
                                            <Grid>
                                                <Border x:Name="veil" Background="Transparent"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"/>
                                                <ContentPresenter x:Name="content"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="veil" Property="Background" Value="#18FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="veil" Property="Background" Value="#22000000"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="content" Property="Opacity" Value="0.55"/>
                                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Speichern" FontSize="22" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Order positions list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="10,6,10,4">
                    <ItemsControl ItemsSource="{Binding OrderPositions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,4" Background="#F5F6F7" CornerRadius="7" ClipToBounds="True">
                                    <Grid MinHeight="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Colour strip, outlined like the product tiles (same border settings) so
                                             light product colours stay visible against the grey row. -->
                                        <Border Grid.Column="0" Background="{Binding Product.Color}" CornerRadius="6,0,0,6"
                                                BorderThickness="0.9" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                            <Border.BorderBrush>
                                                <MultiBinding Converter="{StaticResource BrushColoredBorderConverter}">
                                                    <Binding Path="Product.Color"/>
                                                    <Binding Path="DataContext.BorderDarkenFactor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="DataContext.UseColoredBorder" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.BorderBrush>
                                        </Border>
                                        <!-- Amount -->
                                        <TextBlock Grid.Column="1" Text="{Binding Amount}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#333"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <!-- Product name -->
                                        <TextBlock Grid.Column="2" Text="{Binding Product.Name}"
                                                   FontSize="16" FontWeight="SemiBold" Foreground="#222"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Margin="6,10,6,10"/>
                                        <!-- Unit price -->
                                        <TextBlock Grid.Column="3" Text="{Binding Product.Price, StringFormat={}{0:C}}"
                                                   FontSize="14" Foreground="#606060"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <!-- Fine divider so the button does not read as part of the price. -->
                                        <Border Grid.Column="4" Width="1" HorizontalAlignment="Left" Margin="0,12"
                                                Background="#DADCE0"/>
                                        <!-- Take one off: the counterpart to tapping the tile. Turns into an X at
                                             amount 1, since the next tap removes the whole row. -->
                                        <Button Grid.Column="4" Style="{StaticResource DecreaseButton}"
                                                Command="{Binding DataContext.DecreaseOrderPositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
