<UserControl x:Class="KerwaKasse.MVVM.View.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:KerwaKasse.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <TextBlock Text="Auswertung" Foreground="Black" FontSize="30" Margin="20,0,0,10" DockPanel.Dock="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,20">
            <DatePicker VerticalAlignment="Center" SelectedDate="{Binding DateFrom}" DisplayDate="{Binding DateFrom}" SelectedDateFormat="Long"/>
            <ComboBox VerticalAlignment="Center" ItemsSource="{Binding TimeFrom_Values}" SelectedItem="{Binding TimeFrom}" 
                      Margin="5,0,15,0" ItemStringFormat="{}{0:HH:mm} Uhr" Width="120"/>
            <TextBlock VerticalAlignment="Center" Text="bis" FontSize="20"/>
            <DatePicker VerticalAlignment="Center" SelectedDate="{Binding DateTo}" DisplayDate="{Binding DateTo}"
                        Margin="15,0,5,0" SelectedDateFormat="Long"/>
            <ComboBox VerticalAlignment="Center" ItemsSource="{Binding TimeTo_Values}" SelectedItem="{Binding TimeTo}" 
                      ItemStringFormat="{}{0:HH:mm} Uhr" Width="120"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <DockPanel LastChildFill="False" Margin="15">
                    <Border Background="LightGray" HorizontalAlignment="Stretch" DockPanel.Dock="Top">
                        <Grid Margin="10,5,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="Bold" Grid.Column="0" Text="Bezeichnung" FontSize="16"/>
                            <TextBlock FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center" Text="Anzahl" FontSize="16"/>
                            <TextBlock FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Center" Text="Umsatz" FontSize="16"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding OrderPositions}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" DockPanel.Dock="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,1,10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Product.Description}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{Binding Amount}" FontSize="16"/>
                                    <TextBlock Grid.Column="3" Margin="0,0,15,0" HorizontalAlignment="Right" Text="{Binding Total, StringFormat={}{0:C}}" FontSize="16"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border DockPanel.Dock="Top" HorizontalAlignment="Stretch" Height="1.5" Background="Black" Margin="6"/>
                    <DockPanel LastChildFill="False" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="0,0,25,0">
                        <TextBlock FontWeight="SemiBold" FontSize="20" DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:C}}" Grid.Column="1"/>
                        <TextBlock FontWeight="SemiBold" FontSize="20" DockPanel.Dock="Right" Text="Gesamtumsatz" Margin="0,0,12,0"/>
                    </DockPanel>
                </DockPanel>
            </ScrollViewer>

            <lvc:PieChart Grid.Column="1" Series="{Binding PieChartData}" MaxHeight="700" Margin="10" 
                          LegendPosition="Bottom" VerticalAlignment="Stretch"
                          Background="Transparent">
            </lvc:PieChart>
        </Grid>
    </DockPanel>
</UserControl>
