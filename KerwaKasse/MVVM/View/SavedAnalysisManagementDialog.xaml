<ui:ContentDialog x:Class="KerwaKasse.MVVM.View.SavedAnalysisManagementDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:helper="clr-namespace:KerwaKasse.Helper"
             mc:Ignorable="d"
             Padding="0"
             d:DesignHeight="760" d:DesignWidth="780">

    <ui:ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <sys:Double x:Key="ContentDialogMaxWidth">1000</sys:Double>
        <!-- Allow the tall layout: the default ContentDialog max-height clips our fixed Height when the
             window is large/maximized. The code-behind still caps the content to the window on small screens. -->
        <sys:Double x:Key="ContentDialogMaxHeight">980</sys:Double>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helper:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B929E"/>
        </Style>

        <ControlTemplate x:Key="ValidationErrorTemplate">
            <AdornedElementPlaceholder/>
        </ControlTemplate>
        <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationErrorTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnalysisListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,9"/>
            <!-- Right-clicking a row selects it and opens a per-item context menu (duplicate/delete).
                 Tag carries the management view model so the menu items can reach its commands. -->
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="AnalysisItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <!-- DataContext = the management VM (via the item's Tag), so the items can bind its
                         commands directly; this also flows into the nested confirm submenu. -->
                    <ContextMenu FontSize="14" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Duplizieren" Command="{Binding DuplicateCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Löschen" Foreground="#C0392B">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#C0392B"/>
                            </MenuItem.Icon>
                            <MenuItem Header="Ja, wirklich löschen" Command="{Binding DeleteCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C0392B"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E5EA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D7DEE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#3A4750"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="MoveButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Subtle accent "link" button for Alle/Keine so they stand out a little. -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9ECF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:ContentDialog.Resources>

    <Grid x:Name="RootGrid" Width="720" Height="760" PreviewMouseDown="Root_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="22,12,12,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Auswertungen verwalten" FontSize="21" FontWeight="SemiBold"
                           Foreground="#1B1E24" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="2" Click="CloseButton_Click" Background="Transparent" BorderThickness="0"
                        Width="40" Height="40" Padding="0" Cursor="Hand" ToolTip="Schließen">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#586070"/>
                </Button>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#ECEFF3" BorderBrush="#E2E5EA" BorderThickness="0,0,1,0"
                    CornerRadius="0,0,0,8">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="14"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding AddCommand}" Style="{StaticResource CustomAccentButtonStyle}"
                                HorizontalAlignment="Stretch" Height="42">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Neue Auswertung" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Grid>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                                 ItemContainerStyle="{StaticResource AnalysisListItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonDown="SidebarList_MouseDown"
                                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock x:Name="NameTb" Text="{Binding Name}" FontSize="15" Foreground="#1B1E24"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="#8B929E"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="NameTb" Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                            <Setter TargetName="NameTb" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#AAB0BA"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Noch keine Auswertungen" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#1B1E24" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <Button Command="{Binding AddCommand}" Style="{StaticResource CustomAccentButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Auswertung anlegen" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Right pane -->
            <Grid Grid.Column="1">
                <TextBlock Text="Keine Auswertung ausgewählt" Foreground="#8B929E" FontSize="15"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"/>

                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <!-- Footer (save/discard when dirty) -->
                    <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#EDEFF2"
                            BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,8,0"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Verwerfen" Command="{Binding DiscardCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="#586070"
                                    Padding="14,8" FontSize="15" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource CustomAccentButtonStyle}" Padding="20,9">
                                <TextBlock Text="Speichern" FontSize="15" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
                        <DockPanel MinHeight="430" Height="{Binding ViewportHeight, ElementName=DetailScroller}">

                            <!-- Name -->
                            <StackPanel DockPanel.Dock="Top" Margin="24,20,24,0">
                                <Grid>
                                    <TextBlock Text="NAME" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-4,0,-4"
                                            Background="#FFF4DE" CornerRadius="10" Padding="9,3"
                                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#D69E2E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Geändert" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="#8A6D17" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NameBox" Grid.Column="0"
                                             Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource ValidatedTextBox}" MaxLength="40"
                                             FontSize="16" Height="40" VerticalContentAlignment="Center" Padding="12,0"/>
                                    <Button Grid.Column="1" x:Name="DeleteButton" Width="44" Height="40" Margin="10,0,0,0"
                                            Padding="0" Background="White" BorderBrush="#E3B5B0" BorderThickness="1"
                                            ToolTip="Auswertung löschen">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#C0392B"/>
                                        <ui:FlyoutService.Flyout>
                                            <ui:Flyout Placement="Bottom">
                                                <StackPanel MaxWidth="240">
                                                    <TextBlock Text="Diese Auswertung wirklich löschen?" TextWrapping="Wrap"
                                                               FontSize="14" Foreground="#1B1E24"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                                        <Button Content="Abbrechen" Click="CancelDelete_Click" Padding="14,6" Margin="0,0,8,0"/>
                                                        <Button Content="Löschen" Click="ConfirmDelete_Click" Style="{StaticResource DangerButton}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ui:Flyout>
                                        </ui:FlyoutService.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock FontSize="12" Foreground="#E53935" Margin="0,5,0,0"
                                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=NameBox}"
                                           Visibility="{Binding (Validation.HasError), ElementName=NameBox, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                            <!-- Reorder + duplicate -->
                            <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                                <TextBlock Text="REIHENFOLGE" Style="{StaticResource SectionLabel}"/>
                                <Grid Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource MoveButton}" Command="{Binding MoveUpCommand}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="Nach oben" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MoveButton}" Command="{Binding MoveDownCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="Nach unten" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Position indicator: clicking it swaps to a text box for direct position input. -->
                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPositionText}" FontSize="12.5" Foreground="#8A8F96"
                                                   VerticalAlignment="Center" Cursor="Hand"
                                                   ToolTip="Klicken, um die Position direkt einzugeben"
                                                   Visibility="{Binding IsEditingPosition, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding BeginPositionEditCommand}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                        <TextBox x:Name="PositionInputBox" Width="52" FontSize="12.5" VerticalAlignment="Center"
                                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                                 Text="{Binding PositionInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsEditingPosition, Converter={StaticResource BoolToVisibility}}"
                                                 IsVisibleChanged="PositionInputBox_IsVisibleChanged"
                                                 PreviewKeyDown="PositionInputBox_PreviewKeyDown"
                                                 PreviewTextInput="PositionInputBox_PreviewTextInput"
                                                 LostFocus="PositionInputBox_LostFocus"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <!-- Zeitraum (stacked rows, wider pickers, weekday shown via Long format) -->
                            <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                                <TextBlock Text="ZEITRAUM" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <DatePicker SelectedDate="{Binding DateFrom}" DisplayDate="{Binding DateFrom}" SelectedDateFormat="Long"
                                                Width="250" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding TimeFrom_Values}" SelectedItem="{Binding TimeFrom}" Width="90"
                                              ItemStringFormat="{}{0:HH:mm}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="bis" FontSize="13" Foreground="#8B929E" Margin="2,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <DatePicker SelectedDate="{Binding DateTo}" DisplayDate="{Binding DateTo}" SelectedDateFormat="Long"
                                                Width="250" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding TimeTo_Values}" SelectedItem="{Binding TimeTo}" Width="90"
                                              ItemStringFormat="{}{0:HH:mm}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Produkte (header + search docked, list fills) -->
                            <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                                <Button DockPanel.Dock="Right" Command="{Binding ClearProductsCommand}" Content="Keine"
                                        Style="{StaticResource SmallActionButton}"/>
                                <Button DockPanel.Dock="Right" Command="{Binding SelectAllProductsCommand}" Content="Alle"
                                        Style="{StaticResource SmallActionButton}" Margin="0,0,4,0"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="PRODUKTE" FontSize="12.5" FontWeight="SemiBold" Foreground="#8B929E"/><Run Text="   "/><Run Text="{Binding ProductSelectionSummary, Mode=OneWay}" FontSize="12.5" Foreground="#8B929E"/>
                                </TextBlock>
                            </DockPanel>
                            <!-- Search (manual placeholder so it stays vertically centered) -->
                            <Grid DockPanel.Dock="Top" Margin="24,8,24,0">
                                <TextBox Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38" VerticalContentAlignment="Center" Padding="36,0,10,0"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8B929E"
                                           IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="13,0,0,0"/>
                                <TextBlock Text="Produkt suchen …" Foreground="#9AA0A6" FontSize="14" IsHitTestVisible="False"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="36,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProductSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,12,18,6">
                                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinHeight="34"
                                                      VerticalContentAlignment="Center" Margin="0,1" Padding="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding ColorBrush}"
                                                            BorderBrush="{Binding ColorBorderBrush}" BorderThickness="1"
                                                            Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:ContentDialog>
