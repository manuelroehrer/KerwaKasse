<Window x:Class="KerwaKasse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KerwaKasse"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:KerwaKasse.MVVM.ViewModel"
        xmlns:view="clr-namespace:KerwaKasse.MVVM.View"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d" Background="#F5F6F6"
        Title="KerwaKasse" Height="700" Width="1000">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <view:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <view:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <view:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <view:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
            <view:DatabaseView/>
        </DataTemplate>

        <Style x:Key="tb_style" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border  x:Name="border"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 Background="{TemplateBinding Background}"
                                 SnapsToDevicePixels="True">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                            </Trigger>
                            <Trigger Property="IsChecked" Value="true">
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <ContentControl Margin="75,10,10,10" Content="{Binding CurrentView}"/>

        <!--// Navigation Panel //-->
        <Grid   x:Name="nav_pnl"
                    HorizontalAlignment="Left"
                    Width="65"
                    Background="#0A2433">

            <DockPanel VerticalAlignment="Stretch">

                <!--// Grid for the Menu Toggle Button //-->

                <StackPanel Orientation="Horizontal" Height="90" DockPanel.Dock="Top">

                    <!--// Toggle Button //-->
                    <ToggleButton x:Name="Tg_Btn" Grid.Column="0" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Margin="8,0,0,0" Height="50" Width="50" BorderThickness="0">

                        <!--// Toggle button default background image //-->
                        <ToggleButton.Content>
                            <Image x:Name="RotateImage" Source="Assets/navBar.png" 
                                   Stretch="Uniform" RenderTransformOrigin=".5,.5"/>
                        </ToggleButton.Content>

                        <!--// Toggle Button - Checked, Unchecked events //-->
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard x:Name="HideStackPanel">
                                        <DoubleAnimation                                                    
                                                Storyboard.TargetName="nav_pnl"
                                                Storyboard.TargetProperty="Width"
                                                BeginTime="0:0:0"
                                                From="230" To="65"
                                                Duration="0:0:0.2">
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard x:Name="ShowStackPanel">
                                        <DoubleAnimation                                                
                                                Storyboard.TargetName="nav_pnl"
                                                Storyboard.TargetProperty="Width"
                                                BeginTime="0:0:0"
                                                From="65" To="230"
                                                Duration="0:0:0.3">
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>

                    <!--// Menu title text //-->
                    <TextBlock  Grid.Row="1" Grid.Column="0" Margin="20,0,0,0" Text="M E N Ü" Foreground="White" FontWeight="Bold" FontSize="30"
                                Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center">
                            
                            <!--// Shadow Effect //-->
                        <TextBlock.Effect>
                            <DropShadowEffect  BlurRadius="3" ShadowDepth="1" Direction="-90" Color="White"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <DockPanel LastChildFill="False" VerticalAlignment="Stretch">
                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding HomeViewCommand}" IsChecked="True">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Image Margin="12" Source="Assets/home_w.png"/>
                                <TextBlock Text="Startseite" FontSize="20" Grid.Column="1"  VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Startseite" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding ProductsViewCommand}">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Image Margin="12" Source="Assets/fast-food_w.png"/>
                                <TextBlock Text="Produkte" FontSize="20" Grid.Column="1"  VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Produkte" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding HistoryViewCommand}">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Image Margin="10,12,14,12" Source="Assets/history_w.png"/>
                                <TextBlock Text="Verlauf" FontSize="20" Grid.Column="1"  VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Verlauf" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding StatisticsViewCommand}">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Image Margin="10,12,14,12" Source="Assets/Statistics_w.png"/>
                                <TextBlock Text="Auswertung" FontSize="20" Grid.Column="1"  VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Auswertung" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding DatabaseViewCommand}">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Image Margin="12" Source="Assets/database_w.png"/>
                                <TextBlock Text="Datenbank" FontSize="20" Grid.Column="1"  VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Datenbank" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </DockPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
