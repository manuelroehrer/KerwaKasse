<Window x:Class="KerwaKasse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KerwaKasse"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:KerwaKasse.MVVM.ViewModel"
        xmlns:view="clr-namespace:KerwaKasse.MVVM.View"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#06141E"
        ui:TitleBar.Foreground="White"
        ui:TitleBar.InactiveBackground="#06141E"
        ui:TitleBar.InactiveForeground="#80FFFFFF"
        mc:Ignorable="d" Background="#F3F3F3"
        Title="KerwaKasse" Height="700" Width="1000">

    <ui:TitleBar.ButtonStyle>
        <Style TargetType="{x:Type ui:TitleBarButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="InactiveForeground" Value="#80FFFFFF"/>
            <Setter Property="HoverBackground" Value="#33FFFFFF"/>
            <Setter Property="HoverForeground" Value="White"/>
            <Setter Property="PressedBackground" Value="#55FFFFFF"/>
            <Setter Property="PressedForeground" Value="White"/>
        </Style>
    </ui:TitleBar.ButtonStyle>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OrderPanelViewModel}">
            <view:OrderPanelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <view:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <view:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <view:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
            <view:DatabaseView/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <ContentControl x:Name="MainContent" Margin="60,0,0,0" Content="{Binding CurrentView}"
                        Background="Transparent"/>

        <!--// Navigation Panel //-->
        <Grid   x:Name="nav_pnl"
                    HorizontalAlignment="Left"
                    Width="60"
                    Background="#0A2433">

            <Grid.Effect>
                <DropShadowEffect x:Name="NavShadow" ShadowDepth="0" Direction="0" BlurRadius="12" Opacity="0.12" Color="Black"/>
            </Grid.Effect>

            <DockPanel VerticalAlignment="Stretch">

                <!--// Hamburger Toggle Button //-->
                <Border DockPanel.Dock="Top" Height="56">
                    <ToggleButton x:Name="Tg_Btn"
                                  Background="Transparent"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="11.5,0,0,0"
                                  Height="36" Width="36"
                                  BorderThickness="0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="4"
                                                    Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>

                        <ToggleButton.Content>
                            <TextBlock x:Name="HamburgerIcon"
                                       Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="White"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </ToggleButton.Content>

                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="nav_pnl"
                                            Storyboard.TargetProperty="Width"
                                            To="220"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="NavShadow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.55"
                                            Duration="0:0:0.2"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HamburgerIcon"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            To="90"
                                            Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="nav_pnl"
                                            Storyboard.TargetProperty="Width"
                                            To="60"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="NavShadow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.12"
                                            Duration="0:0:0.18"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HamburgerIcon"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            To="0"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>
                </Border>

                <DockPanel LastChildFill="False" VerticalAlignment="Stretch">
                    <!-- Kasse -->
                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding OrderPanelViewCommand}" IsChecked="True"
                             Click="NavButton_Click">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Kasse" FontSize="16" Grid.Column="1"
                                           VerticalAlignment="Center" Foreground="White" Margin="4,0,0,0"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Kasse" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <!-- Produkte -->
                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding ProductsViewCommand}"
                             Click="NavButton_Click">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xED56;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Produkte" FontSize="16" Grid.Column="1"
                                           VerticalAlignment="Center" Foreground="White" Margin="4,0,0,0"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Produkte" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <!-- Verlauf -->
                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding HistoryViewCommand}"
                             Click="NavButton_Click">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Verlauf" FontSize="16" Grid.Column="1"
                                           VerticalAlignment="Center" Foreground="White" Margin="4,0,0,0"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Verlauf" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <!-- Auswertung -->
                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding StatisticsViewCommand}"
                             Click="NavButton_Click">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Auswertung" FontSize="16" Grid.Column="1"
                                           VerticalAlignment="Center" Foreground="White" Margin="4,0,0,0"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Auswertung" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <!-- Datenbank -->
                    <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavigationButtonTheme}"
                             Command="{Binding DatabaseViewCommand}"
                             Click="NavButton_Click">
                        <RadioButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Datenbank" FontSize="16" Grid.Column="1"
                                           VerticalAlignment="Center" Foreground="White" Margin="4,0,0,0"/>
                            </Grid>
                        </RadioButton.Content>
                        <RadioButton.ToolTip>
                            <ToolTip Content="Datenbank" Style="{StaticResource NavigationToolTipTheme}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </DockPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
